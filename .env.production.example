# ==============================================================
# Events-Square — PRODUCTION environment template
# انسخ هذا الملف على السيرفر إلى laravel_app/.env واملأ القيم
# لا يُرفع أبداً إلى git — القيم الحقيقية تبقى على السيرفر فقط
# ==============================================================

APP_NAME="ساحة الفعاليات"
APP_ENV=production
APP_KEY=                # php artisan key:generate على السيرفر
APP_DEBUG=false         # إلزامي false في الإنتاج
APP_URL=https://eventssquare.sa

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL الإنتاج
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=eventssquare.sa
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@eventssquare.sa"
MAIL_FROM_NAME="${APP_NAME}"

# حسابات الإدارة — كلمات مرور قوية وفريدة، تُدار خارج git
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
